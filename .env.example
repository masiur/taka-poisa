# Copy to .env and change before running `docker compose up -d`.
POSTGRES_PASSWORD=change-me-to-a-long-random-string
BASE_URL=http://localhost:8080
# PORT=8080

# Optional: Google sign-in. Create an OAuth client (type "Web application") at
# https://console.cloud.google.com/apis/credentials and add the redirect URI
#   <BASE_URL>/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
