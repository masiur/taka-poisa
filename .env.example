# Copy to .env and change before running `docker compose up -d`.
POSTGRES_PASSWORD=change-me-to-a-long-random-string
BASE_URL=http://localhost:8080
# PORT=8080

# Email for reminders. Any SMTP provider works, for example:
#   Mailjet:  SMTP_HOST=in-v3.mailjet.com  SMTP_PORT=587  (API key / secret as username / password)
#   Brevo:    SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587
#   Amazon SES: SMTP_HOST=email-smtp.<region>.amazonaws.com SMTP_PORT=587
# SMTP_FROM must be an address on a domain you verified with the provider (SPF/DKIM).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=reminders@example.com
# SMTP_FROM_NAME=Taka Poisa
# SMTP_TLS=starttls   # starttls (587), tls (465) or none (local relay only)
