# Copy to .env and change before running `docker compose up -d`.
POSTGRES_PASSWORD=change-me-to-a-long-random-string
BASE_URL=http://localhost:8080
# PORT=8080
# open: anyone who can reach the server can create an account with their own ledger.
# SIGNUP=closed

# Email for reminders. Any SMTP provider works, for example:
#   Mailjet:  SMTP_HOST=in-v3.mailjet.com  SMTP_PORT=587  (API key / secret as username / password)
#   Brevo:    SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587
#   Amazon SES: SMTP_HOST=email-smtp.<region>.amazonaws.com SMTP_PORT=587
# SMTP_FROM must be an address on a domain you verified with the provider (SPF/DKIM).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=reminders@example.com
# SMTP_FROM_NAME=Taka Poisa
# SMTP_TLS=starttls   # starttls (587), tls (465) or none (local relay only)

# SMS reminders through your own gateway (optional).
# Any HTTP SMS API: the URL/body are templates with {to} (+8801…), {to_digits} (8801…),
# {to_local} (01…) and {message}. Check your provider's docs for the exact parameters.
# SMS_PROVIDER=http
# SMS_HTTP_URL=https://sms.example.com/api/send?api_key=YOUR_KEY&sender=YOUR_ID&to={to_digits}&text={message}
# SMS_HTTP_METHOD=GET            # or POST with SMS_HTTP_BODY (form, or JSON with SMS_HTTP_CONTENT_TYPE)
# SMS_HTTP_SUCCESS=success       # optional: text a successful response contains
#
# Or Twilio:
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15550001111
